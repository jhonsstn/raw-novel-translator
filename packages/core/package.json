{
  "name": "@novel/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@novel/db": "workspace:*",
    "@novel/sources": "workspace:*",
    "@novel/translation": "workspace:*",
    "sharp": "0.34.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
