# Absolute path to the SQLite database for local development.
# Docker Compose overrides this with /data/library.sqlite.
DATABASE_PATH=/absolute/path/to/library.sqlite

# Public origin used to validate Host and Origin headers.
APP_ORIGIN=http://localhost:3000

# Generate once with: openssl rand -base64 32
# Keep the same value for web and worker; changing it makes stored provider keys unreadable.
APP_SECRET_KEY=replace-with-32-random-bytes-encoded-as-base64

# Optional: exact origins allowed for private or HTTP OpenAI-compatible providers.
# Example: http://127.0.0.1:11434
AI_ALLOWED_PRIVATE_ORIGINS=

# Host port published by Docker Compose.
PORT=3000
